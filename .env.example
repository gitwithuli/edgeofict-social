# Dashboard Authentication
DASHBOARD_PASSWORD=your_secure_password_here
FLASK_SECRET_KEY=your_random_secret_key_here

# Anthropic API
ANTHROPIC_API_KEY=your_key_here

# X/Twitter API (v2 with OAuth 2.0)
TWITTER_API_KEY=your_key_here
TWITTER_API_SECRET=your_secret_here
TWITTER_ACCESS_TOKEN=your_token_here
TWITTER_ACCESS_SECRET=your_secret_here
TWITTER_BEARER_TOKEN=your_bearer_token_here

# Facebook Page API
FACEBOOK_PAGE_ID=your_page_id
FACEBOOK_PAGE_TOKEN=your_page_token

# Instagram (via Facebook Graph API)
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id

# Cloudinary (for image hosting)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Profile (for social cards)
PROFILE_PICTURE_URL=https://pbs.twimg.com/profile_images/your_image.jpg
PROFILE_NAME=EdgeOfICT
PROFILE_HANDLE=@edgeofict

# Notification (optional)
EMAIL_NOTIFICATIONS=false
EMAIL_TO=your_email@example.com
